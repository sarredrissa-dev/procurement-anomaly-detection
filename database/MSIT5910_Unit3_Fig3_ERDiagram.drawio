<mxfile host="app.diagrams.net" modified="2026-09-01T00:00:00.000Z" agent="Claude" version="21.0.0">
  <diagram name="ER Diagram" id="er-diagram">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Figure 3: ER Diagram — Database Schema&#xa;Government Procurement Anomaly Detection System — PostgreSQL" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="1000" height="50" as="geometry" />
        </mxCell>

        <!-- VENDORS TABLE -->
        <mxCell id="vendors_hdr" value="vendors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="vendors_body" value="🔑 vendor_id (PK) — SERIAL&#xa;recipient_name — VARCHAR(500) NOT NULL&#xa;vendor_category — VARCHAR(100)&#xa;state — VARCHAR(100)&#xa;country — VARCHAR(100)&#xa;vendor_frequency — INTEGER&#xa;created_at — TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1F4E79;fontSize=11;align=left;spacingLeft=8;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="260" height="160" as="geometry" />
        </mxCell>

        <!-- CONTRACTS TABLE -->
        <mxCell id="contracts_hdr" value="contracts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="contracts_body" value="🔑 contract_id (PK) — SERIAL&#xa;award_id — VARCHAR(100) UNIQUE&#xa;awarding_agency — VARCHAR(200)&#xa;contract_type — VARCHAR(100)&#xa;naics_code — VARCHAR(20)&#xa;period_start — DATE&#xa;period_end — DATE&#xa;award_day_of_year — INTEGER&#xa;created_at — TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1F4E79;fontSize=11;align=left;spacingLeft=8;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="140" width="300" height="210" as="geometry" />
        </mxCell>

        <!-- PROCUREMENT_RECORDS TABLE -->
        <mxCell id="records_hdr" value="procurement_records" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="230" y="420" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="records_body" value="🔑 record_id (PK) — SERIAL&#xa;🔗 vendor_id (FK → vendors)&#xa;🔗 contract_id (FK → contracts)&#xa;total_dollars_obligated — DECIMAL(15,2)&#xa;current_total_value — DECIMAL(15,2)&#xa;potential_total_value — DECIMAL(15,2)&#xa;is_synthetic — BOOLEAN DEFAULT FALSE&#xa;dataset_source — VARCHAR(50)&#xa;fiscal_year — INTEGER&#xa;loaded_at — TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="230" y="460" width="320" height="240" as="geometry" />
        </mxCell>

        <!-- ANOMALY_FLAGS TABLE -->
        <mxCell id="flags_hdr" value="anomaly_flags" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C00000;strokeColor=#990000;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="420" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="flags_body" value="🔑 flag_id (PK) — SERIAL&#xa;🔗 record_id (FK → procurement_records)&#xa;isolation_forest_score — DECIMAL(8,6)&#xa;zscore_deviation — DECIMAL(8,4)&#xa;flag_type — VARCHAR(100)&#xa;risk_factor_explanation — TEXT&#xa;is_synthetic_anomaly — BOOLEAN&#xa;flagged_at — TIMESTAMP&#xa;analyst_feedback — VARCHAR(20)&#xa;  (actionable/not_actionable/pending)&#xa;feedback_timestamp — TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#C00000;fontSize=11;align=left;spacingLeft=8;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="460" width="340" height="260" as="geometry" />
        </mxCell>

        <!-- AUDIT_LOG TABLE -->
        <mxCell id="audit_hdr" value="audit_log" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7030A0;strokeColor=#4B006E;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="audit_body" value="🔑 log_id (PK) — SERIAL&#xa;user_role — VARCHAR(50)&#xa;action_attempted — VARCHAR(200)&#xa;action_result — VARCHAR(50)&#xa;ip_address — VARCHAR(50)&#xa;logged_at — TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7030A0;fontSize=11;align=left;spacingLeft=8;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="460" width="240" height="160" as="geometry" />
        </mxCell>

        <!-- RELATIONSHIPS -->
        <!-- vendors to procurement_records (1 to many) -->
        <mxCell id="rel1" value="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1F4E79;strokeWidth=2;fontStyle=1;fontSize=12;startArrow=ERone;startFill=0;endArrow=ERmanyToOne;endFill=0;" edge="1" source="vendors_body" target="records_body" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- contracts to procurement_records (1 to many) -->
        <mxCell id="rel2" value="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1F4E79;strokeWidth=2;fontStyle=1;fontSize=12;startArrow=ERone;startFill=0;endArrow=ERmanyToOne;endFill=0;" edge="1" source="contracts_body" target="records_body" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- procurement_records to anomaly_flags (1 to many) -->
        <mxCell id="rel3" value="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C00000;strokeWidth=2;fontStyle=1;fontSize=12;startArrow=ERone;startFill=0;endArrow=ERmanyToOne;endFill=0;" edge="1" source="records_body" target="flags_body" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="leg_bg" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="730" width="920" height="60" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="🔑 = Primary Key (PK)  |  🔗 = Foreign Key (FK)  |  1 = One side of relationship  |  M = Many side  |  Schema normalized to Third Normal Form (3NF)&#xa;anomaly_flags stores both Isolation Forest score and z-score independently per contract [Peer 1]  |  analyst_feedback enables actionability rate calculation [Peer 2]  |  risk_factor_explanation supports explainable scores [Peer 3]" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="735" width="900" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
