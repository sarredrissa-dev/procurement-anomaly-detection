        <mxCell id="title" value="Figure 2: Data Flow Diagram — ETL to Dashboard Pipeline&#xa;Government Procurement Anomaly Detection System" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
